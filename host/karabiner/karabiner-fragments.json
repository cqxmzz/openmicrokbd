  "rules": [
    {
      "description": "F13 (DZ60 PTT key) -> F18 so swptt-daemon can enforce the 800ms floor",
      "manipulators": [
        {
          "from": {
            "key_code": "f13",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "f18"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Volume keys -> volstep-daemon (international3/1; no shell_command on the hot path)",
      "manipulators": [
        {
          "from": {
            "key_code": "volume_increment",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "international3"
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "volume_decrement",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "international1"
            }
          ],
          "type": "basic"
        }
      ]
    },
